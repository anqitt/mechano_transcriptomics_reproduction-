# macOS
.DS_Store

# Python caches and environments
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
.conda/
conda-env/

# Jupyter
.ipynb_checkpoints/

# Editors and temporary files
.idea/
.vscode/
*.swp
*.swo
*~
.tmp/
tmp/
temp/
*.tmp
*.log

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Downloaded datasets and large intermediate outputs
data/
datasets/
downloads/
intermediate/
outputs/
results/raw/
results/intermediate/
*.h5ad
*.loom
*.zarr/
*.tar
*.tar.gz
*.zip

# Keep intentionally curated final figures even if a parent output directory is added later
!figures/
!figures/**
!results/final/
!results/final/**

# Keep the compact, curated outputs from the official synthetic tutorial
!outputs/
outputs/*
!outputs/stage3_synthetic/
!outputs/stage3_synthetic/*.png
!outputs/stage3_synthetic/*.csv
!outputs/stage3_synthetic/run_summary.json

# Keep only the compact Step 4B inspection figures; real data remain under data/
!outputs/stage4b_real_data/
outputs/stage4b_real_data/*
!outputs/stage4b_real_data/*.png

# Keep compact derived tables and figures for the Figure 3c reproduction
!outputs/stage4c_figure3c/
outputs/stage4c_figure3c/*
!outputs/stage4c_figure3c/*.png
!outputs/stage4c_figure3c/*.csv
!outputs/stage4c_figure3c/run_summary.json

# Keep compact deterministic Figure 5 benchmark tables; full matrices stay under data/
!outputs/stage5c_figure5_benchmark/
outputs/stage5c_figure5_benchmark/*
!outputs/stage5c_figure5_benchmark/*.csv
!outputs/stage5c_figure5_benchmark/session_info.txt
